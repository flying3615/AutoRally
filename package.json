    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
